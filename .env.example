APP_ENV=development
APP_NAME=AutoClip Transform
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://autoclip:autoclip@postgres:5432/autoclip
REDIS_URL=redis://redis:6379/0
STORAGE_ROOT=/app/storage
MAX_UPLOAD_SIZE_BYTES=2147483648
MAX_VIDEO_DURATION_SECONDS=7200
JOB_TIMEOUT_SECONDS=3600
WORKER_CONCURRENCY=1
AI_PROVIDER=mock
AI_MODEL=
TITLE_MODEL=gpt-5.5
OPENAI_API_KEY=
YOUTUBE_API_KEY=
TRANSCRIPTION_PROVIDER=mock
TRANSCRIPTION_MODEL=whisper-1
TRANSLATION_MODEL=gpt-5.5
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
MEDIA_RETENTION_DAYS=30
MAX_SAVED_TOP_CLIPS=5
KEEP_ORIGINAL_VIDEO=false
TEMP_RETENTION_HOURS=24
AUTO_DELETE_TEMP_FILES=true
ORIGINALITY_MIN_CONTRIBUTION_RATIO=0.55
ORIGINALITY_MAX_SOURCE_RATIO=0.45
ORIGINALITY_MAX_UNINTERRUPTED_SOURCE_SECONDS=10
ORIGINALITY_MIN_COMMENTARY_WORD_RATIO=0.35
REPETITION_SIMILARITY_THRESHOLD=0.75
CELERY_TASK_ALWAYS_EAGER=false
PREVIEW_WIDTH=540
PREVIEW_HEIGHT=960
FINAL_WIDTH=1080
FINAL_HEIGHT=1920
